<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnRetour"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_bouton_rond"
            android:contentDescription="@string/retour"
            android:src="@drawable/ic_retour" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/parametres"
            android:textColor="@color/texte"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Heures creuses -->
            <TextView
                style="@style/TitreSection"
                android:text="@string/section_hc" />

            <LinearLayout
                style="@style/Carte.Section">

                <LinearLayout
                    android:id="@+id/listePlages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtAucunePlage"
                    style="@style/Aide"
                    android:text="@string/aucune_plage" />

                <Button
                    android:id="@+id/btnAjouterPlage"
                    style="@style/BoutonSecondaire"
                    android:layout_marginTop="8dp"
                    android:text="@string/ajouter_plage" />
            </LinearLayout>

            <!-- Option heures creuses -->
            <TextView
                style="@style/TitreSection"
                android:text="@string/section_option_hc" />

            <LinearLayout style="@style/Carte.Section">

                <LinearLayout style="@style/LigneReglage">

                    <TextView
                        style="@style/LibelleReglage"
                        android:text="@string/avance_max" />

                    <Button
                        android:id="@+id/btnAvanceMoins"
                        style="@style/BoutonPas"
                        android:contentDescription="@string/diminuer"
                        android:text="@string/moins" />

                    <TextView
                        android:id="@+id/txtAvance"
                        style="@style/ValeurReglage" />

                    <Button
                        android:id="@+id/btnAvancePlus"
                        style="@style/BoutonPas"
                        android:contentDescription="@string/augmenter"
                        android:text="@string/plus" />
                </LinearLayout>

                <TextView
                    style="@style/Aide"
                    android:text="@string/aide_avance" />
            </LinearLayout>

            <!-- Machine -->
            <TextView
                style="@style/TitreSection"
                android:text="@string/section_machine" />

            <LinearLayout style="@style/Carte.Section">

                <LinearLayout style="@style/LigneReglage">

                    <TextView
                        style="@style/LibelleReglage"
                        android:text="@string/delai_max" />

                    <Button
                        android:id="@+id/btnDelaiMoins"
                        style="@style/BoutonPas"
                        android:contentDescription="@string/diminuer"
                        android:text="@string/moins" />

                    <TextView
                        android:id="@+id/txtDelaiMax"
                        style="@style/ValeurReglage" />

                    <Button
                        android:id="@+id/btnDelaiPlus"
                        style="@style/BoutonPas"
                        android:contentDescription="@string/augmenter"
                        android:text="@string/plus" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notifications -->
            <TextView
                style="@style/TitreSection"
                android:text="@string/section_notifications" />

            <LinearLayout style="@style/Carte.Section">

                <CheckBox
                    android:id="@+id/caseRappel60"
                    style="@style/Case"
                    android:text="@string/rappel_60" />

                <CheckBox
                    android:id="@+id/caseRappel30"
                    style="@style/Case"
                    android:text="@string/rappel_30" />

                <CheckBox
                    android:id="@+id/caseRappel10"
                    style="@style/Case"
                    android:text="@string/rappel_10" />

                <CheckBox
                    android:id="@+id/caseFin"
                    style="@style/Case"
                    android:text="@string/notif_fin" />

                <TextView
                    android:id="@+id/txtEtatNotifs"
                    style="@style/Aide"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnReglagesNotifs"
                    style="@style/BoutonSecondaire"
                    android:layout_marginTop="8dp"
                    android:text="@string/ouvrir_reglages_notifs"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtEtatAlarmes"
                    style="@style/Aide"
                    android:layout_marginTop="8dp"
                    android:text="@string/alarmes_exactes_message"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnReglagesAlarmes"
                    style="@style/BoutonSecondaire"
                    android:layout_marginTop="8dp"
                    android:text="@string/ouvrir_reglages_alarmes"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Icône -->
            <TextView
                style="@style/TitreSection"
                android:text="@string/section_icone" />

            <LinearLayout style="@style/Carte.Section">

                <Switch
                    android:id="@+id/switchIcone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/icone_dynamique"
                    android:textColor="@color/texte"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Aide"
                    android:text="@string/aide_icone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
