<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- En-tête -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titre_accueil"
                        android:textColor="@color/texte"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHeure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnParametres"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_bouton_rond"
                    android:contentDescription="@string/parametres"
                    android:src="@drawable/ic_parametres" />
            </LinearLayout>

            <!-- Saisies -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/carteFin"
                    style="@style/Carte.Saisie"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/lblFin"
                        style="@style/Libelle"
                        android:text="@string/fin_souhaitee" />

                    <TextView
                        android:id="@+id/txtFin"
                        style="@style/ValeurSaisie" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/carteCycle"
                    style="@style/Carte.Saisie"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/lblCycle"
                        style="@style/Libelle"
                        android:text="@string/duree_cycle" />

                    <TextView
                        android:id="@+id/txtCycle"
                        style="@style/ValeurSaisie" />
                </LinearLayout>
            </LinearLayout>

            <!-- Choix du mode -->
            <LinearLayout
                android:id="@+id/segment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnStandard"
                    style="@style/Segment"
                    android:text="@string/au_plus_juste" />

                <TextView
                    android:id="@+id/btnHC"
                    style="@style/Segment"
                    android:text="@string/heures_creuses" />
            </LinearLayout>

            <!-- Résultat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_carte_sombre"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtLibelleResultat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sur_sombre_secondaire"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtDelai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:textColor="@color/sur_sombre_accent"
                    android:textSize="60sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sur_sombre"
                    android:textSize="15sp" />
            </LinearLayout>

            <fr.perso.hublot.FriseView
                android:id="@+id/frise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/txtComparaison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/texte"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtChangementHeure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/info_changement_heure"
                android:textColor="@color/cible"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/puceFin"
                style="@style/Puce"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/puceRappels"
                style="@style/Puce"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bouton_principal"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/blanc"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
